---
const technologies = [
  "Astro", "React", "Tailwind CSS", "Laravel", "Go", "Python",
  "Docker", "PostgreSQL", "MySQL", "SQLite", "Vercel",
  "Supabase", "Firebase", "OpenAI", "Claude", "Gemini", "Figma"
];
---

<section class="border-t border-line bg-surface" aria-label="Teknologi yang kami pakai">
  <div class="wrap flex items-center gap-6 py-4">
    <p class="m-0 shrink-0 font-mono text-[0.7rem] font-bold uppercase tracking-[0.12em] text-muted">
      teknologi
    </p>

    {/* Salinan kedua murni dekoratif; pembaca layar cukup baca yang pertama. */}
    <div class="marquee min-w-0 flex-1">
      <div class="marquee-track">
        {[false, true].map((clone) => (
          <ul class="m-0 flex shrink-0 list-none gap-x-8 p-0 pr-8" aria-hidden={clone || undefined}>
            {technologies.map((tech) => (
              <li class="font-mono text-[0.8rem] whitespace-nowrap text-ink-soft">{tech}</li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>
