---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Halaman Tidak Ditemukan | Hiperkreatif"
  description="Halaman yang Anda cari tidak ditemukan. Kembali ke halaman utama Hiperkreatif."
  robots="noindex, nofollow"
>
  <section class="flex flex-grow items-center bg-surface">
    <div class="wrap py-20 md:py-28">
      <div class="max-w-[60ch]">
        <p class="eyebrow m-0">error 404</p>

        <h1 class="display mt-5 text-[clamp(2.4rem,5.2vw,3.8rem)]">Rute tidak ditemukan.</h1>

        <p class="lede mt-5">
          Halaman yang Anda cari sudah dipindahkan atau tidak pernah ada. Kalau Anda sampai di
          sini dari tautan kami sendiri, tolong beri tahu supaya bisa kami perbaiki.
        </p>

        <div class="mt-8 flex flex-wrap gap-2.5">
          <a href="/" class="btn btn-primary">Kembali ke beranda</a>
          <a
            href="https://wa.me/6285157445924?text=Halo%20Hiperkreatif%2C%20saya%20menemukan%20error%20404%20saat%20mengakses%20halaman%20di%20website."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary">Laporkan masalah</a
          >
        </div>

        <div class="mt-12 border-t border-line pt-6">
          <p class="m-0 font-mono text-[0.75rem] text-muted">coba salah satu ini:</p>
          <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[0.8rem]">
            <a href="/#layanan" class="link inline-block py-1">layanan</a>
            <a href="/jurnal" class="link inline-block py-1">jurnal</a>
            <a href="/konsultasi" class="link inline-block py-1">konsultasi</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
