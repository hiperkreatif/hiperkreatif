---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BLOGS } from "../../constants/blogs";

export function getStaticPaths() {
  return BLOGS.map((blog) => ({
    params: { slug: blog.slug },
    props: { blog },
  }));
}

const { blog } = Astro.props;
const others = BLOGS.filter((b) => b.slug !== blog.slug).slice(0, 3);

// id disuntikkan ke tiap <h2> supaya subjudulnya bisa ditautkan langsung —
// dipakai untuk berbagi tautan ke bagian tertentu, dan supaya mesin bisa
// merujuk potongan yang spesifik, bukan cuma halamannya.
const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/<[^>]+>/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

const content = blog.content.replace(
  /<h2>(.*?)<\/h2>/g,
  (_: string, t: string) => `<h2 id="${slugify(t)}">${t}</h2>`
);
---

<BaseLayout
  title={`${blog.title} | Jurnal | Hiperkreatif`}
  description={blog.excerpt}
  ogImageAlt={`${blog.title} — Jurnal Hiperkreatif`}
>
  <article class="wrap py-14 md:py-20">
    <nav class="mb-8 font-mono text-[0.75rem] text-muted" aria-label="Breadcrumb">
      <a href="/" class="transition-colors hover:text-accent">beranda</a>
      <span class="mx-2 text-line-strong">/</span>
      <a href="/blog" class="transition-colors hover:text-accent">jurnal</a>
    </nav>

    <header class="border-b border-line pb-10">
      <div class="flex flex-wrap items-center gap-3 font-mono text-[0.72rem]">
        <span class="tag">{blog.category}</span>
        <span class="text-muted">{blog.date}</span>
      </div>

      <h1 class="display mt-6 max-w-[26ch] text-[clamp(2.2rem,4.8vw,3.4rem)]">
        {blog.title}
      </h1>

      <p class="lede mt-5 max-w-[64ch]">{blog.excerpt}</p>
    </header>

    {/* Kolom teks dibatasi 90ch (±103 karakter per baris pada prose-lg).
        max-w-none akan membuatnya 142 karakter, dua kali lipat patokan baca.
        Sisa kanannya diisi "baca juga" yang dulu ada di bawah artikel. Rail
        ini TIDAK disembunyikan di mobile — isinya konten, bukan hiasan; di
        layar sempit grid-nya menumpuk dan daftarnya jatuh di bawah artikel,
        persis posisi lamanya. */}
    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-16">
      <div
        class="prose prose-lg max-w-[90ch]
             prose-headings:font-display prose-headings:font-extrabold prose-headings:tracking-[-0.03em] prose-headings:text-ink
             prose-h2:text-[1.6rem] prose-h3:text-[1.2rem]
             prose-p:text-ink-soft prose-p:leading-relaxed
             prose-a:text-accent prose-a:decoration-1 prose-a:underline-offset-4
             prose-strong:font-bold prose-strong:text-ink
             prose-ul:text-ink-soft prose-ol:text-ink-soft prose-li:marker:text-accent
             prose-code:rounded-sm prose-code:bg-surface prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-[0.85em] prose-code:text-ink prose-code:before:content-none prose-code:after:content-none
             prose-pre:rounded-md prose-pre:border prose-pre:border-term-line prose-pre:bg-term prose-pre:text-term-text
             prose-blockquote:border-l-2 prose-blockquote:border-accent prose-blockquote:pl-5 prose-blockquote:font-normal prose-blockquote:not-italic prose-blockquote:text-muted
             prose-hr:border-line
             prose-img:rounded-md prose-img:border prose-img:border-line"
        set:html={content}
      />

      {
        others.length > 0 && (
          <aside class="lg:sticky lg:top-24 lg:self-start" aria-labelledby="lainnya-title">
            <p id="lainnya-title" class="label m-0">
              baca juga
            </p>
            <ul class="mt-4 mb-0 list-none border-t border-line p-0">
              {others.map((b) => (
                <li class="border-b border-line">
                  <a href={`/blog/${b.slug}`} class="group block py-4">
                    <span class="font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted">
                      {b.category}
                    </span>
                    <h3 class="display-sm mt-2 text-[0.98rem] leading-snug transition-colors group-hover:text-accent">
                      {b.title}
                    </h3>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </article>

  <!-- ══ CTA ═══════════════════════════════════════════════ -->
  <section class="wrap pb-16 pt-8">
    <div class="rounded-lg border border-line px-5 py-12 text-center">
      <h2 class="display mx-auto max-w-[24ch] text-[clamp(1.5rem,3.2vw,2.2rem)]">
        Butuh solusi spesifik untuk bisnis Anda?
      </h2>
      <p class="mx-auto mt-4 mb-0 max-w-[54ch] text-muted">
        Kami membantu perusahaan ambisius memangkas inefisiensi lewat teknologi tepat guna.
      </p>
      <a href="/consultation" class="btn btn-primary mt-7">Jadwalkan konsultasi</a>
    </div>
  </section>
</BaseLayout>
