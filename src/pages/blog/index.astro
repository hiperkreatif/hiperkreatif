---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BLOGS } from "../../constants/blogs";
---

<BaseLayout
  title="Jurnal Efisiensi Bisnis & Teknologi | Hiperkreatif"
  description="Kumpulan artikel mendalam tentang strategi e-commerce, dominasi media sosial, pengembangan website korporat, dan otomatisasi bisnis dengan AI."
>
  <!-- ══ HERO ══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden border-b border-line bg-surface">
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-35" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_40%,transparent_20%,var(--color-surface)_85%)]"
      aria-hidden="true"
    >
    </div>

    <div class="wrap relative z-10 py-14 md:py-20">
      <p class="eyebrow m-0">jurnal</p>
      <h1 class="display mt-5 max-w-[18ch] text-[clamp(2.4rem,5.2vw,3.8rem)]">
        Catatan dari lapangan.
      </h1>
      <p class="lede mt-5 max-w-[60ch]">
        Apa yang kami temukan saat membereskan sistem bisnis orang lain: biaya yang tidak
        kelihatan, kebiasaan yang mahal, dan hal-hal yang ternyata tidak perlu dibangun.
      </p>
    </div>
  </section>

  <!-- ══ DAFTAR ════════════════════════════════════════════ -->
  <section class="wrap py-4">
    <!-- Tanpa border-b: section CTA di bawah sudah punya border-t, dan dua
         garis berjarak py-4 terbaca sebagai garis dobel. -->
    <ul class="m-0 list-none divide-y divide-line p-0">
      {
        BLOGS.map((blog) => (
          <li>
            <a
              href={`/blog/${blog.slug}`}
              class="group grid gap-4 py-8 transition-colors md:grid-cols-[minmax(0,0.26fr)_minmax(0,1fr)_auto] md:items-start md:gap-8"
            >
              <!-- flex-col, bukan flex-wrap: dengan wrap, tanggal yang pendek
                   ikut naik sebaris dengan chip sementara yang panjang turun,
                   jadi barisnya tidak rata antar item. -->
              <div class="flex flex-col items-start gap-2 font-mono text-[0.72rem]">
                <span class="tag">{blog.category}</span>
                <span class="text-muted">{blog.date}</span>
              </div>

              <div>
                <h2 class="display-sm m-0 max-w-[34ch] text-[clamp(1.15rem,2.2vw,1.5rem)] transition-colors group-hover:text-accent">
                  {blog.title}
                </h2>
                <p class="mt-3 mb-0 max-w-[70ch] text-[0.92rem] leading-relaxed text-muted">
                  {blog.excerpt}
                </p>
              </div>

              <span
                class="hidden font-mono text-[0.9rem] text-muted transition-colors group-hover:text-accent md:inline"
                aria-hidden="true">→</span
              >
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ══ CTA ═══════════════════════════════════════════════ -->
  <section class="border-t border-line">
    <div class="wrap py-16 text-center md:py-20">
      <h2 class="display mx-auto max-w-[22ch] text-[clamp(1.5rem,3.2vw,2.2rem)]">
        Kendala Anda belum ada artikelnya?
      </h2>
      <p class="mx-auto mt-4 mb-0 max-w-[50ch] text-muted">
        Ceritakan langsung saja. Telepon 30 menit, gratis.
      </p>
      <a href="/consultation" class="btn btn-primary mt-7">Jadwalkan konsultasi</a>
    </div>
  </section>
</BaseLayout>
