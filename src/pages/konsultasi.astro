---
import BaseLayout from "../layouts/BaseLayout.astro";

const EXPECTATIONS = [
  {
    title: "Targetnya ditulis di awal",
    body: "Angka yang mau dicapai kita sepakati sebelum mulai, lalu dicek bersama setelah sistemnya jalan.",
  },
  {
    title: "Anda selalu tahu posisinya",
    body: "Progres dilaporkan tiap minggu, dan Anda bicara langsung dengan orang yang mengerjakan.",
  },
  {
    title: "Kami bisa bilang tidak",
    body: "Kalau kebutuhan Anda lebih murah selesai pakai tool jadi, kami sampaikan di panggilan pertama.",
  },
];
---

<BaseLayout
  title="Konsultasi Gratis | Hiperkreatif"
  description="Ceritakan kendala operasional bisnis Anda. Kami petakan di mana margin bocor dan apakah sistem digital bisa menutupnya. Tanpa kewajiban."
>
  {/* ══ HERO ══════════════════════════════════════════════ */}
  <section class="border-b border-line bg-surface">
    <div class="wrap py-12 md:py-20">
      <p class="eyebrow m-0">telepon perkenalan</p>
      <h1 class="display mt-5 max-w-[16ch] text-[clamp(2.4rem,5.2vw,3.8rem)]">
        Ceritakan kendalanya.
      </h1>
      <p class="lede mt-5 max-w-[62ch]">
        Isi brief singkat di bawah, atau langsung telepon. Kami petakan di mana
        margin Anda bocor, lalu bilang terus terang apakah kami orang yang tepat untuk
        membereskannya.
      </p>
    </div>
  </section>

  {/* ══ EKSPEKTASI + FORM ═════════════════════════════════ */}
  <section class="wrap">
    <div class="grid divide-y divide-line lg:grid-cols-[minmax(260px,0.55fr)_minmax(0,1fr)] lg:divide-x lg:divide-y-0">
      {/* Kiri */}
      <div class="py-12 lg:pr-10">
        <p class="label m-0">ekspektasi kerja sama</p>

        <ul class="mt-7 grid list-none gap-7 p-0">
          {
            EXPECTATIONS.map((e, i) => (
              <li>
                <div class="flex items-center gap-3">
                  <span class="tag">{String(i + 1).padStart(2, "0")}</span>
                  <h2 class="display-sm m-0 text-[1.05rem]">{e.title}</h2>
                </div>
                <p class="mt-2.5 mb-0 text-[0.9rem] leading-relaxed text-muted">{e.body}</p>
              </li>
            ))
          }
        </ul>

        <p class="mt-9 mb-0 font-mono text-[0.75rem] leading-relaxed text-muted">
          Lebih suka langsung ngobrol?<br />
          <a
            href="https://wa.me/6285157445924"
            target="_blank"
            rel="noopener noreferrer"
            class="link inline-block py-1">wa.me/6285157445924</a
          >
        </p>
      </div>

      {/* Kanan: form */}
      <div class="py-12 lg:pl-10">
        {/* action/method/target adalah jalur cadangan: kalau skripnya gagal,
             submit tetap membuka WhatsApp alih-alih menghapus semua isian. */}
        <form
          id="konsultasi-form"
          class="grid gap-6"
          action="https://wa.me/6285157445924"
          method="get"
          target="_blank"
        >
          <div class="grid gap-6 md:grid-cols-2">
            <div class="grid gap-2">
              <label
                for="name"
                class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.1em] text-muted"
                >Nama / perwakilan</label
              >
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="Cth: Budi Santoso"
                class="w-full rounded-md border border-line bg-bg px-3 py-2.5 text-[0.95rem] text-ink transition-colors placeholder:text-muted/70 focus:border-accent focus:outline-none"
              />
            </div>

            <div class="grid gap-2">
              <label
                for="company"
                class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.1em] text-muted"
                >Nama perusahaan <span class="font-normal normal-case tracking-normal">(opsional)</span></label
              >
              <input
                type="text"
                id="company"
                name="company"
                autocomplete="organization"
                placeholder="Cth: PT Sukses Makmur"
                class="w-full rounded-md border border-line bg-bg px-3 py-2.5 text-[0.95rem] text-ink transition-colors placeholder:text-muted/70 focus:border-accent focus:outline-none"
              />
            </div>
          </div>

          <div class="grid gap-2">
            <label
              for="brief"
              class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.1em] text-muted"
              >Apa yang sedang macet?</label
            >
            <textarea
              id="brief"
              name="brief"
              rows="7"
              required
              placeholder="Cth: order dari chat masih disalin manual ke spreadsheet, sering salah dan stok telat diperbarui…"
              class="w-full resize-y rounded-md border border-line bg-bg px-3 py-2.5 text-[0.95rem] leading-relaxed text-ink transition-colors placeholder:text-muted/70 focus:border-accent focus:outline-none"
            ></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" class="btn btn-primary">
              Kirim via WhatsApp
              <span aria-hidden="true">→</span>
            </button>
            <p id="form-hint" class="m-0 font-mono text-[0.72rem] text-muted">
              Membuka WhatsApp dengan brief terisi otomatis.
            </p>
          </div>

          <p
            id="form-status"
            class="m-0 hidden max-w-[52ch] font-mono text-[0.72rem] leading-relaxed text-muted"
            role="status"
            aria-live="polite"
          >
            WhatsApp dibuka di tab baru. Tidak muncul?
            <a id="form-fallback" href="#" target="_blank" rel="noopener noreferrer" class="link"
              >buka manual</a
            >, atau kirim ke
            <a href="mailto:hi@hiperkreatif.com" class="link">hi@hiperkreatif.com</a>.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('konsultasi-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const fallback = document.getElementById('form-fallback') as HTMLAnchorElement | null;
  const hint = document.getElementById('form-hint');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const data = new FormData(form);
    const company = (data.get('company') as string)?.trim();
    const lines = [
      'Halo Hiperkreatif, saya mau konsultasi.',
      '',
      `*Nama:* ${data.get('name')}`,
      ...(company ? [`*Perusahaan:* ${company}`] : []),
      `*Yang sedang macet:* ${data.get('brief')}`,
      '',
      'Kapan bisa telepon?',
    ];

    const url = `https://wa.me/6285157445924?text=${encodeURIComponent(lines.join('\n'))}`;

    if (fallback) fallback.href = url;
    hint?.classList.add('hidden');
    status?.classList.remove('hidden');

    window.open(url, '_blank', 'noopener');
  });
</script>
