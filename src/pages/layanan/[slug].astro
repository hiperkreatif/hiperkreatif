---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LAYANAN } from "../../constants/layanan";
import { ids, breadcrumb } from "../../constants/schema";

export function getStaticPaths() {
  return LAYANAN.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const encodedServiceName = encodeURIComponent(service.name);
const whatsappLink = `https://wa.me/6285157445924?text=Halo%20Hiperkreatif,%20saya%20butuh%20bantuan%20terkait%20${encodedServiceName}.%20Boleh%20diskusi?`;

const others = LAYANAN.filter((s) => s.slug !== service.slug);
const weeks = service.timeline;

const satuan = service.price.unit === "month" ? "per bulan" : "per proyek";
const hargaMulai = service.price.from
  ? new Intl.NumberFormat("id-ID", {
      style: "currency",
      currency: service.price.currency,
      maximumFractionDigits: 0,
    }).format(service.price.from)
  : "";

// @id-nya sengaja sama dengan node Service di @graph beranda supaya dua-duanya
// dibaca sebagai satu entitas, bukan dua layanan berbeda dengan nama sama.
const S = ids(Astro.site);
const serviceUrl = S.url(`/layanan/${service.slug}`);
---

<BaseLayout
  title={`${service.name} | Hiperkreatif`}
  description={service.desc}
  ogImageAlt={`${service.name} | Layanan Digital Hiperkreatif`}
>
  {/* ══ HERO ══════════════════════════════════════════════ */}
  <section class="border-b border-line bg-surface">
    <div class="wrap py-12 md:py-24">
      <nav class="mb-8 font-mono text-[0.75rem] text-muted" aria-label="Breadcrumb">
        <a href="/" class="inline-block py-1 transition-colors hover:text-accent">beranda</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/#layanan" class="inline-block py-1 transition-colors hover:text-accent">layanan</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-ink-soft">{service.name}</span>
      </nav>

      <p class="eyebrow m-0">{service.badge}</p>

      <h1 class="display mt-5 max-w-[18ch] text-[clamp(2.4rem,5.2vw,4rem)]">
        {service.name}
      </h1>

      <p class="lede mt-5 max-w-[58ch]">{service.tagline}</p>

      <div class="mt-8 flex flex-wrap gap-2.5">
        <a href="/konsultasi" class="btn btn-primary">Jadwalkan konsultasi</a>
        <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          Tanya via WhatsApp
        </a>
      </div>

      <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-4 font-mono text-[0.78rem]">
        {
          hargaMulai && (
            <div>
              <dt class="text-muted">mulai dari</dt>
              <dd class="m-0 text-ink">
                {hargaMulai} <span class="text-muted">{satuan}</span>
              </dd>
            </div>
          )
        }
        <div>
          <dt class="text-muted">estimasi</dt>
          <dd class="m-0 text-ink">{weeks.minWeeks}–{weeks.maxWeeks} minggu</dd>
        </div>
        <div>
          <dt class="text-muted">garansi</dt>
          <dd class="m-0 text-ink">
            {service.support.warrantyDays > 0 ? `${service.support.warrantyDays} hari` : "berlangganan"}
          </dd>
        </div>
        <div>
          <dt class="text-muted">respons</dt>
          <dd class="m-0 text-ink">≤ {service.support.slaHours} jam</dd>
        </div>
      </dl>
    </div>
  </section>

  {/* ══ KONTEKS ═══════════════════════════════════════════ */}
  <section class="wrap section" aria-labelledby="konteks-title">
    <div class="grid gap-8 md:grid-cols-[minmax(0,0.42fr)_minmax(0,1fr)] md:gap-14">
      <h2 id="konteks-title" class="display m-0 text-[clamp(1.6rem,3.4vw,2.4rem)]">
        Kenapa ini penting.
      </h2>
      <p class="lede m-0 max-w-[70ch]">{service.desc}</p>
    </div>
  </section>

  {/* ══ NILAI EKSEKUSI ════════════════════════════════════ */}
  <section class="section" aria-labelledby="nilai-title">
    <div class="wrap mb-10">
      <p class="eyebrow m-0">nilai eksekusi</p>
      <h2 id="nilai-title" class="display mt-4 max-w-[22ch] text-[clamp(1.8rem,4vw,3rem)]">
        Yang Anda dapatkan.
      </h2>
    </div>

    <div class="cells cells-fill md:grid-cols-2 lg:grid-cols-3">
      {
        service.bullets.map((b: string, i: number) => (
          <article class="flex min-h-[180px] flex-col py-8">
            <span class="tag">{String(i + 1).padStart(2, "0")}</span>
            <p class="mt-5 mb-0 text-[0.92rem] leading-relaxed text-ink-soft">{b}</p>
          </article>
        ))
      }
    </div>
  </section>

  {/* ══ LAYANAN LAIN ══════════════════════════════════════ */}
  <section class="section" aria-labelledby="lain-title">
    <div class="wrap mb-10">
      <p class="eyebrow m-0">layanan lain</p>
      <h2 id="lain-title" class="display mt-4 text-[clamp(1.6rem,3.4vw,2.4rem)]">
        Sering dipasangkan dengan ini.
      </h2>
    </div>

    <div class="cells md:grid-cols-3">
      {
        others.map((s) => (
          <a href={s.cta} class="group flex flex-col py-8">
            <span class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-muted">
              {s.badge}
            </span>
            <h3 class="display-sm mt-3 text-[1.1rem] transition-colors group-hover:text-accent">
              {s.name}
            </h3>
            <p class="mt-3 mb-0 text-[0.88rem] leading-relaxed text-muted">{s.tagline}</p>
            <span
              class="mt-auto inline-flex items-center gap-2 pt-6 font-mono text-[0.78rem] font-bold text-accent"
              aria-hidden="true"
            >
              Pelajari detail
              <span>→</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  {/* ══ FAQ ═══════════════════════════════════════════════ */}
  <section class="section" aria-labelledby="faq-title">
    <div class="wrap mb-8">
      <p class="eyebrow m-0">pertanyaan umum</p>
      <h2 id="faq-title" class="display mt-4 max-w-[20ch] text-[clamp(1.6rem,3.4vw,2.4rem)]">
        Yang biasanya ditanyakan.
      </h2>
    </div>

    <div class="wrap">
      {
        service.faqs.map((f: { q: string; a: string }) => (
          <details class="group border-b border-line">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[0.98rem] font-bold text-ink marker:hidden hover:text-accent">
              {f.q}
              <span
                class="shrink-0 font-mono text-lg text-muted transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="mb-5 max-w-[75ch] text-[0.94rem] leading-relaxed text-muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  {/* ══ CTA ═══════════════════════════════════════════════ */}
  <section class="print-hide border-t border-line">
    <div class="wrap py-16 text-center md:py-20">
      <p class="eyebrow m-0">langkah berikutnya</p>
      <h2 class="display mx-auto mt-4 max-w-[22ch] text-[clamp(1.8rem,4vw,2.8rem)]">
        Cek dulu apakah ini masalah Anda.
      </h2>
      <p class="mx-auto mt-4 mb-0 max-w-[54ch] text-muted">
        Kami petakan kendalanya dulu di panggilan awal, sebelum bicara angka.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-2.5">
        <a href="/konsultasi" class="btn btn-primary">Jadwalkan konsultasi</a>
        <a href="/#layanan" class="btn btn-secondary">Lihat semua layanan</a>
      </div>
    </div>
  </section>

  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Service",
          "@id": `${serviceUrl}#service`,
          url: serviceUrl,
          name: service.name,
          alternateName: service.aliases,
          serviceType: service.badge,
          description: service.desc,
          provider: { "@id": S.org },
          areaServed: { "@type": "Country", name: "Indonesia" },
          inLanguage: "id-ID",
          // minPrice, bukan price: yang tampil "mulai dari", jadi angka pasti
          // akan salah untuk sebagian lingkup pekerjaan.
          ...(service.price.from && {
            offers: {
              "@type": "Offer",
              priceCurrency: service.price.currency,
              priceSpecification: {
                "@type": "UnitPriceSpecification",
                priceCurrency: service.price.currency,
                minPrice: service.price.from,
                unitText: service.price.unit === "month" ? "bulan" : "proyek",
              },
            },
          }),
        },
        {
          "@type": "FAQPage",
          "@id": `${serviceUrl}#faq`,
          mainEntity: service.faqs.map((f: { q: string; a: string }) => ({
            "@type": "Question",
            name: f.q,
            acceptedAnswer: { "@type": "Answer", text: f.a },
          })),
        },
        breadcrumb(Astro.site, [
          { name: "Beranda", path: "/" },
          { name: service.name, path: `/layanan/${service.slug}` },
        ]),
      ],
    })}
  />
</BaseLayout>
