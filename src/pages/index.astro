---
import BaseLayout from "../layouts/BaseLayout.astro";
import LogoUrl from "../assets/logo-black.svg?url";
import { SEO } from "../constants/seo";
import { SERVICES } from "../constants/services";
import { FAQS } from "../constants/faqs";
import TechMarquee from "../components/TechMarquee.astro";

const logo = LogoUrl;

const STATS = [
  { val: "15+", label: "proyek b2b selesai", icon: "M4 8h16v11H4zM9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2" },
  { val: "100%", label: "kode & server milik klien", icon: "M15 7a4 4 0 1 1-3.9 5H7v3H4v-3l4.1-4a4 4 0 0 1 3.9-5z" },
  { val: "1–4", label: "minggu sampai versi pertama", icon: "M4 6h16v14H4zM4 10h16M9 3v4M15 3v4" },
  { val: "24/7", label: "berjalan tanpa operator", icon: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3 2" },
];

const STEPS = [
  {
    title: "Telepon 30 menit",
    body: "Anda cerita apa yang macet, kami bilang terus terang kalau itu di luar jangkauan kami atau lebih murah dikerjakan orang lain.",
  },
  {
    title: "Blueprint tertulis",
    body: "Apa yang dibangun, berapa lama, berapa biayanya. Anda setujui dulu sebelum kami mulai.",
  },
  {
    title: "Dibangun bertahap",
    body: "Progres bisa Anda lihat tiap minggu, bukan cuma di akhir. Ganti arah masih murah di tahap ini.",
  },
  {
    title: "Serah terima",
    body: "Sistem berjalan di produksi. Kami dampingi tim Anda sampai tidak perlu bertanya lagi.",
  },
];
---

<BaseLayout>
  <!-- ══ HERO ══════════════════════════════════════════════ -->
  <!-- Siluet logo raksasa menggantikan mock terminal (lihat .logo-ghost) -->
  <section class="relative overflow-hidden">
    <img src={LogoUrl} alt="" aria-hidden="true" class="logo-ghost" />

    <div class="wrap relative py-16 md:py-24 lg:py-28">
      <p class="eyebrow m-0">website · aplikasi · otomasi ai</p>

      <h1 class="display mt-6 max-w-[16ch] text-[clamp(2.6rem,6.4vw,5rem)]">
        Punya kanalnya, <span class="text-accent">bukan menyewanya.</span>
      </h1>

      <p class="lede mt-6 max-w-[56ch]">
        Potongan platform naik lagi Mei 2026, dan sejak 1 Agustus marketplace memungut PPh 0,5%
        tiap transaksi. Kami bangun toko online, profil perusahaan, dan otomasi AI atas nama
        Anda sendiri: kode dan daftar pelanggannya milik Anda.
      </p>

      <div class="mt-9 flex flex-wrap gap-2.5">
        <a href="/consultation" class="btn btn-primary">Jadwalkan telepon 30 menit</a>
        <a href="#layanan" class="btn btn-secondary">Lihat yang kami kerjakan</a>
      </div>

      <p class="mt-6 font-mono text-[0.75rem] text-muted">
        Gratis, tanpa kewajiban lanjut setelahnya.
      </p>
    </div>
  </section>

  <!-- ══ STACK ═════════════════════════════════════════════ -->
  <TechMarquee />

  <!-- ══ ANGKA ═════════════════════════════════════════════ -->
  <section class="cells grid-cols-2 md:grid-cols-4" aria-label="Angka">
    {
      STATS.map((s) => (
        <div class="px-5 py-9 md:px-8">
          <p class="display m-0 text-[clamp(1.9rem,3.6vw,2.7rem)]">{s.val}</p>
          <p class="mt-2.5 mb-0 flex items-center gap-2 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted">
            <svg
              class="h-3.5 w-3.5 shrink-0 text-accent"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={s.icon} />
            </svg>
            {s.label}
          </p>
        </div>
      ))
    }
  </section>

  <!-- ══ LAYANAN ═══════════════════════════════════════════ -->
  <section id="layanan" class="section" aria-labelledby="layanan-title">
    <div class="wrap mb-10 grid items-end gap-6 md:grid-cols-[minmax(0,1fr)_minmax(280px,0.46fr)] md:gap-12">
      <div>
        <p class="eyebrow m-0">yang kami kerjakan</p>
        <h2 id="layanan-title" class="display mt-4 max-w-[20ch] text-[clamp(1.8rem,4vw,3rem)]">
          Empat lini yang saling menyambung.
        </h2>
      </div>
      <p class="m-0 text-muted">
        Kebanyakan klien mulai dari satu yang paling mendesak, lalu menambah yang lain setelah
        yang pertama terbukti jalan.
      </p>
    </div>

    <div class="cells md:grid-cols-2">
      {
        SERVICES.map((s, i) => (
          <article class="card-hover flex flex-col px-5 py-8 md:px-8 md:py-9">
            <div class="flex items-center gap-3">
              <span class="tag">{String(i + 1).padStart(2, "0")}</span>
              <span class="font-mono text-[0.72rem] text-muted">{s.badge}</span>
            </div>

            <h3 class="display-sm mt-5 text-[1.3rem]">{s.name}</h3>
            <p class="mt-3 mb-0 text-[0.95rem] leading-relaxed text-ink-soft">{s.tagline}</p>

            <ul class="mt-6 mb-0 grid gap-2.5 border-t border-line pt-6">
              {s.bullets.slice(0, 3).map((b: string) => (
                <li class="flex gap-3 text-[0.88rem] leading-snug text-muted">
                  <span class="mt-[0.55em] h-1 w-1 shrink-0 bg-accent" aria-hidden="true" />
                  <span>{b}</span>
                </li>
              ))}
            </ul>

            <a
              href={s.cta}
              class="mt-auto inline-flex items-center gap-2 pt-7 font-mono text-[0.8rem] font-bold text-accent transition-colors hover:text-ink"
            >
              Pelajari detail
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ══ CARA KERJA ════════════════════════════════════════ -->
  <section id="proses" class="section" aria-labelledby="proses-title">
    <div class="wrap mb-10 grid items-end gap-6 md:grid-cols-[minmax(0,1fr)_minmax(280px,0.46fr)] md:gap-12">
      <div>
        <p class="eyebrow m-0">cara kerja</p>
        <h2 id="proses-title" class="display mt-4 max-w-[20ch] text-[clamp(1.8rem,4vw,3rem)]">
          Empat langkah sampai sistemnya jalan.
        </h2>
      </div>
      <p class="m-0 text-muted">
        Tiap tahap ada keluaran yang bisa Anda pegang: catatan telepon, blueprint tertulis,
        demo mingguan, lalu akses penuh ke servernya.
      </p>
    </div>

    <ol class="cells list-none p-0 md:grid-cols-2 lg:grid-cols-4">
      {
        STEPS.map((step, i) => (
          <li class="flex min-h-[210px] flex-col px-5 py-8 md:px-8">
            <span class="tag">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="display-sm mt-5 text-[1.1rem]">{step.title}</h3>
            <p class="mt-3 mb-0 text-[0.9rem] leading-relaxed text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ══ GARANSI ═══════════════════════════════════════════ -->
  <section id="garansi" class="relative border-t border-line bg-surface" aria-labelledby="garansi-title">
    <span class="absolute inset-x-0 top-0 h-[3px] bg-accent" aria-hidden="true"></span>
    <div class="wrap py-16 md:py-20">
      <p class="label m-0">garansi hasil</p>
      <h2 id="garansi-title" class="display mt-4 max-w-[24ch] text-[clamp(1.6rem,3.4vw,2.4rem)]">
        Tidak mencapai target, uang Anda kembali.
      </h2>
      <p class="lede mt-5 max-w-[68ch]">
        Target terukurnya kita tetapkan bersama di awal dan ditulis di blueprint. Kalau sistem
        yang kami bangun tidak sampai ke sana, investasi Anda kami kembalikan.
      </p>
    </div>
  </section>

  <!-- ══ FAQ ═══════════════════════════════════════════════ -->
  <section id="faq" class="section" aria-labelledby="faq-title">
    <div class="wrap">
      <p class="eyebrow m-0">pertanyaan umum</p>
      <h2 id="faq-title" class="display mt-4 max-w-[20ch] text-[clamp(1.8rem,4vw,3rem)]">
        Yang paling sering ditanyakan.
      </h2>
    </div>

    <div class="mt-10 border-t border-line">
      {
        FAQS.map((f) => (
          <details class="group border-b border-line">
            <summary class="wrap display-sm flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-[1.05rem] transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
              {f.q}
              <span
                class="mt-1 shrink-0 text-muted transition-transform duration-200 group-open:rotate-45"
                aria-hidden="true"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <!-- .wrap sudah mx-auto; max-w di elemen yang sama akan menimpanya
                 dan bikin jawaban melayang ke tengah. Batasi lebar di anaknya. -->
            <div class="wrap">
              <p class="mb-6 mt-0 max-w-[75ch] text-[0.95rem] leading-relaxed text-muted">
                {f.a}
              </p>
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ══ CTA ═══════════════════════════════════════════════ -->
  <section class="border-t border-line">
    <div class="wrap py-16 text-center md:py-20">
      <p class="eyebrow m-0 justify-center">konsultasi</p>
      <h2 class="display mx-auto mt-4 max-w-[24ch] text-[clamp(1.8rem,4vw,2.8rem)]">
        Mulai dari satu telepon.
      </h2>
      <p class="mx-auto mt-4 mb-0 max-w-[54ch] text-muted">
        30 menit, gratis. Anda keluar dengan gambaran solusi yang konkret, mau lanjut kerja
        sama dengan kami atau tidak.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-2.5">
        <a href="/consultation" class="btn btn-primary">Jadwalkan konsultasi</a>
        <a
          href="https://wa.me/6285157445924?text=Halo%20Hiperkreatif%2C%20saya%20mau%20diskusi%20soal%20sistem%20digital%20bisnis%20saya."
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary">Chat WhatsApp</a
        >
      </div>
    </div>
  </section>

  <!-- JSON-LD @graph tetap di head -->
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://www.hiperkreatif.com/#org",
          name: "Hiperkreatif",
          legalName: SEO.legalName,
          url: "https://www.hiperkreatif.com/",
          logo: {
            "@type": "ImageObject",
            url: logo,
            width: 112,
            height: 112,
          },
          sameAs: [
            "https://github.com/hiperkreatif",
            "https://wa.me/6285157445924",
            "https://instagram.com/hiperkreatif",
            "https://tiktok.com/@hiperkreatif",
            "https://facebook.com/hiperkreatif",
            "https://threads.net/@hiperkreatif",
          ],
          contactPoint: [
            {
              "@type": "ContactPoint",
              contactType: "customer support",
              telephone: "+628157445924",
              email: "hi@hiperkreatif.com",
              availableLanguage: "id",
            },
          ],
          founder: { "@id": "https://www.hiperkreatif.com/#person" },
        },

        {
          "@type": "Person",
          "@id": "https://www.hiperkreatif.com/#person",
          name: "Kang Dadan",
          jobTitle: "Software Engineer & Solo Founder",
          url: "https://www.hiperkreatif.com/",
          image: "https://www.hiperkreatif.com/dadan.jpg",
          worksFor: { "@id": "https://www.hiperkreatif.com/#org" },
        },

        {
          "@type": "WebSite",
          "@id": "https://www.hiperkreatif.com/#website",
          url: "https://www.hiperkreatif.com/",
          name: "Hiperkreatif",
          publisher: { "@id": "https://www.hiperkreatif.com/#org" },
          inLanguage: "id-ID",
          potentialAction: {
            "@type": "SearchAction",
            target: "https://www.hiperkreatif.com/search?q={search_term_string}",
            "query-input": "required name=search_term_string",
          },
        },

        {
          "@type": "WebPage",
          "@id": "https://www.hiperkreatif.com/#webpage",
          url: "https://www.hiperkreatif.com/",
          name: SEO.title,
          description: SEO.description,
          isPartOf: { "@id": "https://www.hiperkreatif.com/#website" },
          about: { "@id": "https://www.hiperkreatif.com/#org" },
          primaryImageOfPage: {
            "@type": "ImageObject",
            url: `https://www.hiperkreatif.com${SEO.ogImage || "/og-cover-1200x630.jpg"}`,
            width: 1200,
            height: 630,
          },
        },

        {
          "@type": "FAQPage",
          "@id": "https://www.hiperkreatif.com/#faq",
          mainEntity: FAQS.map((f) => ({
            "@type": "Question",
            name: f.q,
            acceptedAnswer: { "@type": "Answer", text: f.a },
          })),
        },

        {
          "@type": "SiteNavigationElement",
          name: "Primary navigation",
          url: "https://www.hiperkreatif.com/",
          about: SERVICES.map((s) => ({
            "@type": "WebPage",
            name: s.name,
            url: `https://www.hiperkreatif.com/services/${s.slug}`,
          })),
        },

        ...SERVICES.map((s) => ({
          "@type": "Service",
          "@id": `https://www.hiperkreatif.com/services/${s.slug}`,
          name: s.name,
          serviceType: s.badge,
          url: `https://www.hiperkreatif.com/services/${s.slug}`,
          provider: { "@id": "https://www.hiperkreatif.com/#org" },
          description: s.tagline,
        })),
      ],
    })}
  />
</BaseLayout>
