---
import BaseLayout from "../layouts/BaseLayout.astro";
import LogoUrl from "../assets/logo-black.svg?url";
import og from "../assets/og.webp";
import { SEO } from "../constants/seo";
import { LAYANAN } from "../constants/layanan";
import { FAQS } from "../constants/faqs";
import { ids } from "../constants/schema";

const S = ids(Astro.site);

const sekaliJadi = LAYANAN.filter((s) => s.price.unit === "project");
const mingguProyek = `${Math.min(...sekaliJadi.map((s) => s.timeline.minWeeks))}\u2013${Math.max(
  ...sekaliJadi.map((s) => s.timeline.maxWeeks)
)}`;
const hariGaransi = Math.min(...sekaliJadi.map((s) => s.support.warrantyDays));
const jamBalasan = Math.max(...LAYANAN.map((s) => s.support.slaHours));

const STATS = [
  { val: "15+", label: "proyek selesai", icon: "M4 8h16v11H4zM9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2" },
  { val: `${hariGaransi} hari`, label: "garansi bug, proyek sekali jadi", icon: "M12 3l7 3v6c0 4.2-3 7.4-7 9-4-1.6-7-4.8-7-9V6l7-3zM9 12l2 2 4-4" },
  { val: mingguProyek, label: "minggu sampai versi pertama", icon: "M4 6h16v14H4zM4 10h16M9 3v4M15 3v4" },
  { val: `${jamBalasan} jam`, label: "batas waktu balasan", icon: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3 2" },
];

const STEPS = [
  {
    title: "Telepon perkenalan",
    body: "Anda cerita apa yang macet, kami bilang terus terang kalau itu di luar jangkauan kami atau lebih murah dikerjakan orang lain.",
  },
  {
    title: "Blueprint tertulis",
    body: "Apa yang dibangun, berapa lama, berapa biayanya. Anda setujui dulu sebelum kami mulai.",
  },
  {
    title: "Dibangun bertahap",
    body: "Progres bisa Anda lihat tiap minggu, bukan cuma di akhir. Ganti arah masih murah di tahap ini.",
  },
  {
    title: "Serah terima",
    body: "Sistem berjalan di produksi. Kami dampingi tim Anda sampai tidak perlu bertanya lagi.",
  },
];
---

<BaseLayout>
  <section class="relative overflow-hidden">
    <img src={LogoUrl} alt="" aria-hidden="true" class="logo-ghost" />

    <div class="wrap relative py-10 md:py-20 lg:py-24">
      <p class="eyebrow m-0">toko online · profil perusahaan · media sosial · otomasi ai</p>

      <h1 class="display mt-6 max-w-[27ch] text-[clamp(2.6rem,6vw,5.75rem)] tracking-[-0.055em]">
        Dirancang untuk masalah nyata.
        <span class="text-accent block"><i>Dibangun untuk profitabilitas.</i></span>
      </h1>

      <p class="lede mt-6 max-w-[64ch]">
        Mengubah masalah nyata menjadi solusi yang tepat guna, dengan pendekatan yang
        berorientasi pada hasil, efisiensi, dan profitabilitas bisnis yang berkelanjutan.
      </p>

      <div class="mt-9 flex flex-wrap gap-2.5">
        <a href="/konsultasi" class="btn btn-primary">Jadwalkan konsultasi</a>
        <a href="#layanan" class="btn btn-secondary">Lihat layanannya</a>
      </div>

      <p class="mt-6 font-mono text-[0.75rem] text-muted">
        Gratis, tanpa kewajiban lanjut setelahnya.
      </p>
    </div>
  </section>

  <section class="cells grid-cols-2 md:grid-cols-4" aria-label="Angka">
    {
      STATS.map((s) => (
        <div class="py-9">
          <p class="display m-0 text-[clamp(1.9rem,3.6vw,2.7rem)]">{s.val}</p>
          <p class="mt-2.5 mb-0 flex items-center gap-2 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-muted">
            <svg
              class="h-3.5 w-3.5 shrink-0 text-accent"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={s.icon} />
            </svg>
            {s.label}
          </p>
        </div>
      ))
    }
  </section>

  <section id="layanan" class="section" aria-labelledby="layanan-title">
    <div class="wrap mb-10 grid items-end gap-6 md:grid-cols-[minmax(0,1fr)_minmax(280px,0.46fr)] md:gap-12">
      <div>
        <p class="eyebrow m-0">yang kami kerjakan</p>
        <h2 id="layanan-title" class="display mt-4 max-w-[20ch] text-[clamp(1.8rem,4vw,3rem)]">
          Empat lini <i class="block">yang saling menyambung.</i>
        </h2>
      </div>
      <p class="m-0 text-muted">
        Media sosial memasok pengunjung, toko dan profil menampung mereka, otomasi mengurus
        yang tersisa setelah pesanan masuk.
      </p>
    </div>

    <div class="cells md:grid-cols-2">
      {
        LAYANAN.map((s, i) => (
          <article class="card-hover flex flex-col py-8 md:py-9">
            <div class="flex items-center gap-3">
              <span class="tag">{String(i + 1).padStart(2, "0")}</span>
              <span class="font-mono text-[0.72rem] text-muted">{s.badge}</span>
            </div>

            <h3 class="display-sm mt-5 text-[1.3rem]">{s.name}</h3>
            <p class="mt-3 mb-0 text-[0.95rem] leading-relaxed text-ink-soft">{s.tagline}</p>

            <ul class="mt-6 mb-0 grid gap-2.5 border-t border-line pt-6">
              {s.bullets.slice(0, 3).map((b: string) => (
                <li class="flex gap-3 text-[0.88rem] leading-snug text-muted">
                  <span class="mt-[0.55em] h-1 w-1 shrink-0 bg-accent" aria-hidden="true" />
                  <span>{b}</span>
                </li>
              ))}
            </ul>

            <a
              href={s.cta}
              class="mt-auto inline-flex items-center gap-2 pt-7 font-mono text-[0.8rem] font-bold text-accent transition-colors hover:text-ink"
            >
              Pelajari detail
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section id="proses" class="section" aria-labelledby="proses-title">
    <div class="wrap mb-10">
      <p class="eyebrow m-0">cara kerja</p>
      <h2 id="proses-title" class="display mt-4 max-w-[24ch] text-[clamp(1.8rem,4vw,3rem)]">
        Empat langkah <i class="block">sampai sistemnya jalan.</i>
      </h2>
      <p class="mt-5 mb-0 max-w-[56ch] text-muted">
        Tiap tahap ada keluaran yang bisa Anda pegang: catatan telepon, blueprint tertulis,
        demo mingguan, lalu akses penuh ke servernya.
      </p>
    </div>

    <ol class="cells list-none p-0 md:grid-cols-2 lg:grid-cols-4">
      {
        STEPS.map((step, i) => (
          <li class="flex min-h-[210px] flex-col py-8">
            <span class="tag">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="display-sm mt-5 text-[1.1rem]">{step.title}</h3>
            <p class="mt-3 mb-0 text-[0.9rem] leading-relaxed text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="garansi" class="relative border-t border-line bg-surface" aria-labelledby="garansi-title">
    <span class="absolute inset-x-0 top-0 h-[3px] bg-accent" aria-hidden="true"></span>
    <div class="wrap py-16 md:py-20">
      <p class="label m-0">cakupan dan batas</p>
      <h2 id="garansi-title" class="display mt-4 max-w-[26ch] text-[clamp(1.6rem,3.4vw,2.4rem)]">
        Yang kami janjikan ditulis. Yang <i>tidak kami janjikan</i>, juga.
      </h2>
      <dl class="mt-6 mb-0 grid max-w-[72ch] gap-5">
        <div class="grid gap-1.5">
          <dt class="label m-0">yang dijamin</dt>
          <dd class="lede m-0">
            {hariGaransi} hari perbaikan bug tanpa biaya tambahan setelah serah terima, untuk
            proyek sekali jadi. Lingkupnya bug pada pekerjaan kami.
          </dd>
        </div>
        <div class="grid gap-1.5">
          <dt class="label m-0">yang tidak dijamin</dt>
          <dd class="lede m-0">
            Hasil bisnisnya. Sebagian penentunya bukan milik kami: algoritma platform, harga
            pasar, dan besaran budget iklan Anda.
          </dd>
        </div>
        <div class="grid gap-1.5">
          <dt class="label m-0">kapan batasnya disebut</dt>
          <dd class="lede m-0">
            Di panggilan pertama, sebelum ada tanda tangan. Yang kita sepakati di blueprint
            adalah indikator kerjanya.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="faq" class="section" aria-labelledby="faq-title">
    <div class="wrap">
      <p class="eyebrow m-0">pertanyaan umum</p>
      <h2 id="faq-title" class="display mt-4 max-w-[20ch] text-[clamp(1.8rem,4vw,3rem)]">
        Pertanyaan <i class="block">yang paling sering masuk.</i>
      </h2>
    </div>

    <div class="mt-10 border-t border-line">
      {
        FAQS.map((f) => (
          <details class="group border-b border-line">
            <summary class="wrap display-sm flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-[1.15rem] transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
              {f.q}
              <span
                class="mt-1 shrink-0 text-muted transition-transform duration-200 group-open:rotate-45"
                aria-hidden="true"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <div class="wrap">
              <p class="mb-6 mt-0 max-w-[75ch] text-[0.95rem] leading-relaxed text-muted">
                {f.a}
              </p>
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <section class="print-hide border-t border-line">
    <div class="wrap py-16 text-center md:py-20">
      <p class="eyebrow m-0 justify-center">konsultasi</p>
      <h2 class="display mx-auto mt-4 max-w-[24ch] text-[clamp(1.8rem,4vw,2.8rem)]">
        Mulai dari <i class="block">satu telepon.</i>
      </h2>
      <p class="mx-auto mt-4 mb-0 max-w-[54ch] text-muted">
        Gratis dan tanpa kewajiban lanjut. Anda keluar dengan gambaran solusi yang konkret, mau
        kerja sama dengan kami atau tidak.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-2.5">
        <a href="/konsultasi" class="btn btn-primary">Jadwalkan konsultasi</a>
        <a
          href="https://wa.me/6285157445924?text=Halo%20Hiperkreatif%2C%20saya%20mau%20diskusi%20soal%20sistem%20digital%20bisnis%20saya."
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary">Chat WhatsApp</a
        >
      </div>
    </div>
  </section>

  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": S.org,
          name: "Hiperkreatif",
          url: S.base,
          knowsAbout: [...new Set(LAYANAN.flatMap((s: any) => [s.name, ...s.aliases]))],
          logo: {
            "@type": "ImageObject",
            url: LogoUrl,
            width: 112,
            height: 112,
          },
          sameAs: [
            "https://github.com/hiperkreatif",
            "https://wa.me/6285157445924",
            "https://instagram.com/hiperkreatif",
            "https://tiktok.com/@hiperkreatif",
            "https://facebook.com/hiperkreatif",
            "https://threads.net/@hiperkreatif",
          ],
          contactPoint: [
            {
              "@type": "ContactPoint",
              contactType: "customer support",
              telephone: "+6285157445924",
              email: "hi@hiperkreatif.com",
              availableLanguage: "id",
            },
          ],
          founder: { "@id": S.person },
        },

        {
          "@type": "Person",
          "@id": S.person,
          name: SEO.personName,
          jobTitle: SEO.personRole,
          url: S.base,
          image: S.url("/dadan.jpg"),
          worksFor: { "@id": S.org },
        },

        {
          "@type": "WebSite",
          "@id": S.website,
          url: S.base,
          name: "Hiperkreatif",
          publisher: { "@id": S.org },
          inLanguage: "id-ID",
        },

        {
          "@type": "WebPage",
          "@id": `${S.base}#webpage`,
          url: S.base,
          name: SEO.title,
          description: SEO.description,
          isPartOf: { "@id": S.website },
          about: { "@id": S.org },
          primaryImageOfPage: {
            "@type": "ImageObject",
            url: S.url(og.src),
            width: 1200,
            height: 630,
          },
        },

        {
          "@type": "FAQPage",
          "@id": `${S.base}#faq`,
          mainEntity: FAQS.map((f) => ({
            "@type": "Question",
            name: f.q,
            acceptedAnswer: { "@type": "Answer", text: f.a },
          })),
        },

        {
          "@type": "SiteNavigationElement",
          name: "Primary navigation",
          url: S.base,
          about: LAYANAN.map((s) => ({
            "@type": "WebPage",
            name: s.name,
            url: S.url(`/layanan/${s.slug}`),
          })),
        },

        ...LAYANAN.map((s) => ({
          "@type": "Service",
          "@id": `${S.url(`/layanan/${s.slug}`)}#service`,
          alternateName: s.aliases,
          name: s.name,
          serviceType: s.badge,
          url: S.url(`/layanan/${s.slug}`),
          provider: { "@id": S.org },
          description: s.desc,
        })),
      ],
    })}
  />
</BaseLayout>
